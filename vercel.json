{
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    { "src": "/login", "dest": "/api/index.py" },
    { "src": "/signup", "dest": "/api/index.py" },
    { "src": "/logout", "dest": "/api/index.py" },
    { "src": "/habits(.*)", "dest": "/api/index.py" },
    { "src": "/toggle", "dest": "/api/index.py" },
    { "src": "/old-dashboard", "dest": "/api/index.py" },
    { "src": "/static/(.*)", "dest": "/api/index.py" },
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
